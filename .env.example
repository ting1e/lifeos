# ============================================================================
# LifeOS — environment configuration
# ============================================================================
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# Required for the app to boot:  DATABASE_URL, SESSION_SECRET, ADMIN_USERNAME,
#                                ADMIN_PASSWORD
# Required for any AI feature:   OPENAI_API_KEY (+ OPENAI_BASE_URL)
# Optional:                      everything else
# ============================================================================


# --- Database --------------------------------------------------------------
# Postgres 16 connection string. The bundled docker-compose.yml spins up a
# local instance at the URL below.
DATABASE_URL=postgres://lifetracker:lifetracker@localhost:5432/lifetracker


# --- Auth ------------------------------------------------------------------
# 64-byte random base64 string used by iron-session to seal the cookie.
# Generate one with:  openssl rand -base64 64
SESSION_SECRET=replace_with_openssl_rand_base64_64

# Bootstraps the single admin account on first boot.
ADMIN_USERNAME=admin

# First-boot password ONLY. Change it from /profile after logging in.
ADMIN_PASSWORD=changeme


# --- AI (OpenAI-compatible) ------------------------------------------------
# Every AI feature in LifeOS — food photo vision, meal parsing, voice
# transcription, meal planner, workout program generator, weekly insights —
# calls an OpenAI-compatible /v1/chat/completions endpoint.
#
# These are SERVER FALLBACKS. Users can override the base URL, API key, and
# per-usage models (text / image / audio) from their Profile page. When a
# profile value is blank, the matching env var below is used instead.
#
# Examples:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_BASE_URL=https://api.xiaomimimo.com/v1
#
# Default models below cover text, image (vision), and audio (transcription).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-4o-mini
OPENAI_AUDIO_MODEL=gpt-4o-mini


# --- Exercises dataset (optional) -----------------------------------------
# Base URL of the exercises dataset used by `pnpm seed:exercises` and
# `pnpm sync:exercises`. Defaults to the GitHub raw endpoint below.
#
# If raw.githubusercontent.com is blocked in your region, use a mirror:
#   EXERCISES_DATASET_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@main
#   EXERCISES_DATASET_BASE=https://raw.gitmirror.com/hasaneyldrm/exercises-dataset/main
#
# GitHub proxy: if you must route ALL GitHub traffic (incl. the dataset)
# through an HTTP(S) proxy, set HTTPS_PROXY. Node's fetch (undici) does NOT
# read HTTP(S)_PROXY automatically — the seed/sync scripts opt-in via undici
# ProxyAgent when this var is set. Example:
#   HTTPS_PROXY=http://127.0.0.1:7890
EXERCISES_DATASET_BASE=https://raw.githubusercontent.com/hasaneyldrm/exercises-dataset/main
HTTPS_PROXY=


# --- Whoop OAuth (optional) ------------------------------------------------
# Register an app at https://developer.whoop.com to sync recovery, sleep,
# strain, workouts, and body measurements. Leave blank to disable.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback

# Optional — Whoop signs webhooks with the OAuth client_secret by default.
# Only set this if you've configured a separate webhook secret in the portal.
WHOOP_WEBHOOK_SECRET=


# --- App -------------------------------------------------------------------
# Public origin (used in OAuth callbacks and absolute links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to 1 to enable in-process cron jobs (Whoop daily safety-net sync).
# Leave 0 if you run sync from an external scheduler instead.
ENABLE_CRON=0

# IANA timezone. Affects daily rollovers (e.g. "kcal today").
TZ=Asia/Shanghai

# App language (en | tr | zh). Unset → zh. Drives template seed + admin initial locale.
# Note: LANGUAGE is a POSIX locale var; if the shell exports it (e.g. zh_CN:zh),
# that value takes precedence over this file (dotenv won't override existing env).
LANGUAGE=zh

NODE_ENV=development


# --- Uploads ---------------------------------------------------------------
# Local filesystem path for uploaded food photos (served and read locally
# before being sent to the AI as an inline base64 data URI).
UPLOADS_DIR=./uploads
